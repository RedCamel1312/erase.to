BIND=127.0.0.1:3001
PUBLIC_ORIGINS=https://example.com
CACHE_URL=redis+unix:///run/erase-cache/valkey.sock
CACHE_PREFIX=erase:{notes}:
STATIC_DIR=/opt/erase/current/web
POW_BITS=18
MAX_CHALLENGES=4096
MAX_NOTES=2048
MAX_STORAGE_BYTES=268435456
MAX_IN_FLIGHT=2
REQUESTS_PER_SECOND=100
CHALLENGES_PER_SECOND=10
CREATES_PER_SECOND=8
CACHE_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=300000
CONNECTION_LIFETIME_SECONDS=360
REQUIRE_SAFE_CACHE=true
